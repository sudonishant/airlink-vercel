# AirLink v2.0 — Environment Variables
# ---------------------------------------------------------------
# Ye values Vercel me set karni hain:
#   Vercel Dashboard → aapka project → Settings → Environment Variables
#   (Production + Preview + Development teeno me check karein)
#
# SUPABASE_URL aur SUPABASE_SERVICE_KEY yahan milenge:
#   Supabase Dashboard → aapka project → Settings → API
#     - Project URL            -> SUPABASE_URL
#     - service_role (secret)  -> SUPABASE_SERVICE_KEY   ⚠️ kabhi bhi
#       frontend/git me commit mat karna — ye admin key hai!
# ---------------------------------------------------------------

# Supabase project URL (example)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service_role secret key
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key

# Room ka passcode — jo aap apne friends ke saath share karenge
# (chat me entry ke liye zaroori; kuch bhi strong choose karo)
ROOM_PASSCODE=my-secret-room-passcode

# ---- Optional ----
# Storage bucket name (default: airlink; supabase_setup.sql wahi banata hai)
# SUPABASE_BUCKET=airlink

# Max upload size in MB (default: 4; Vercel request limit ~4.5MB)
# MAX_FILE_MB=4

# Token signing secret (default: service key se derive hota hai)
# AUTH_SECRET=

# Extra allowed CORS origins, comma separated (default: same-origin only)
# ALLOWED_ORIGINS=https://mydomain.com
