{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/files/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/:match*",
      "destination": "/public/:match*"
    },
    {
      "source": "/((?!api|files|static|public).*)",
      "destination": "/public/index.html"
    }
  ]
}
