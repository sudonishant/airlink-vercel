{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/files/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/css/:match*",
      "destination": "/css/:match*"
    },
    {
      "source": "/static/js/:match*",
      "destination": "/js/:match*"
    },
    {
      "source": "/static/icons/:match*",
      "destination": "/icons/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "/:match*"
    }
  ]
}
